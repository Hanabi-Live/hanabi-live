// This is a TypeScript configuration intended to be used by packages in this monorepo.
{
  "$schema": "https://raw.githubusercontent.com/complete-ts/complete/main/packages/complete-tsconfig/schemas/tsconfig-strict-schema.json",

  // https://www.typescriptlang.org/docs/handbook/compiler-options.html
  "compilerOptions": {
    "types": ["bun"],
    "rootDir": ".",

    // "target" specifies the ECMAScript target version. Keep it in lockstep with Vite's build
    // target: the newest version that its oldest browser (now Safari 16.4) fully supports. The
    // "game" and "data" packages get their built-in types from it, and the client bundles them.
    // When it reaches ES2024, turn on "regexp/require-unicode-sets-regexp" in ESLint.
    "target": "ES2022",

    // "resolveJsonModule" is required to import files with ".json" extensions. By default, it is
    // false.
    "resolveJsonModule": true,

    // Bun executes TypeScript directly; browser entrypoints are bundled.
    "module": "preserve",
    "moduleResolution": "bundler",

    // Relative imports in "packages/game" end in ".ts", and its build rewrites them to ".js".
    "rewriteRelativeImportExtensions": true,

    "paths": {
      "@hanabi-live/data": ["./packages/data/src/index.ts"],
      "@hanabi-live/game": ["./packages/game/src/index.ts"],
      "@hanabi-live/testing": ["./packages/testing/src/index.ts"],
    },
  },
}
