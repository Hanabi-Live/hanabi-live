{
  "$schema": "https://raw.githubusercontent.com/complete-ts/complete/main/packages/complete-tsconfig/schemas/tsconfig-strict-schema.json",

  "extends": [
    "complete-tsconfig/tsconfig.base.json",
    "../../tsconfig.monorepo.json",
