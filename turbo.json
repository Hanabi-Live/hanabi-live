{
  "$schema": "https://turborepo.dev/schema.json",
  "cacheDir": ".turbo/cache",
  "globalDependencies": [
    ".gitignore",
    "bunfig.toml",
    "eslint.config.mjs",
    "patches/**",
    "tsconfig*.json"
  ],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "lint": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "//#check-shellcheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/*.sh",
        "**/.shellcheckrc",
        "!**/*.md",
        "!**/node_modules/**",
        "!**/.husky/**",
        "!dist/**"
      ],
      "env": [
        "CI",
        "ImageOS",
        "ImageVersion",
        "RUNNER_ARCH",
        "RUNNER_OS",
        "SHELLCHECK_OPTS"
      ],
      "outputs": []
    },
    "//#check-templates": {
      "env": [
        "CI",
        "ImageOS",
        "ImageVersion",
        "NODE_ENV",
        "RUNNER_ARCH",
        "RUNNER_OS"
      ],
      "outputs": []
    },
    "//#check-variant-files": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "env": [
        "CI",
        "ImageOS",
        "ImageVersion",
        "NODE_ENV",
        "RUNNER_ARCH",
        "RUNNER_OS"
      ],
      "outputs": []
    },
    "//#lint-package-json": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "env": [
        "CI",
        "ImageOS",
        "ImageVersion",
        "NODE_ENV",
        "RUNNER_ARCH",
        "RUNNER_OS"
      ],
      "outputs": []
    },
    "@hanabi-live/client-new#test": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.github/workflows/ci.yml",
        "$TURBO_ROOT$/.github/workflows/setup-bun/**",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/packages/client/get-version.sh"
      ],
      "env": [
        "CI",
        "HANABI_BUILD_REVISION",
        "ImageOS",
        "ImageVersion",
        "NODE_ENV",
        "RUNNER_ARCH",
        "RUNNER_OS",
        "TZ"
      ],
      "outputs": []
    },
    "//#lint-rust": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "env": [
        "CARGO_BUILD_TARGET",
        "CARGO_ENCODED_RUSTFLAGS",
        "CI",
        "HANABI_BUILD_REVISION",
        "ImageOS",
        "ImageVersion",
        "RUNNER_ARCH",
        "RUNNER_OS",
        "RUSTFLAGS",
        "RUSTUP_TOOLCHAIN",
        "SQLX_OFFLINE"
      ],
      "passThroughEnv": ["CARGO_HOME", "RUSTUP_HOME"],
      "outputs": []
    },
    "//#test": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "env": [
        "CARGO_BUILD_TARGET",
        "CARGO_ENCODED_RUSTFLAGS",
        "CI",
        "HANABI_BUILD_REVISION",
        "HANABI_TEST_DATABASE_URL",
        "ImageOS",
        "ImageVersion",
        "LD_LIBRARY_PATH",
        "NODE_ENV",
        "RUNNER_ARCH",
        "RUNNER_OS",
        "RUSTFLAGS",
        "RUSTUP_TOOLCHAIN",
        "TZ"
      ],
      "passThroughEnv": ["CARGO_HOME", "RUSTUP_HOME"],
      "outputs": []
    },
    "//#test-lint-caches": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "env": [
        "CI",
        "ImageOS",
        "ImageVersion",
        "NODE_ENV",
        "RUNNER_ARCH",
        "RUNNER_OS"
      ],
      "outputs": []
    }
  }
}
