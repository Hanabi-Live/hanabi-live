{
  "$schema": "https://turborepo.dev/schema.json",
  "cacheDir": ".turbo/cache",
  "globalDependencies": [
    ".gitignore",
    "bunfig.toml",
    "eslint.config.mjs",
    "patches/**",
    "tsconfig*.json"
  ],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "lint": {
      "dependsOn": ["transit"],
      "outputs": []
    }
  }
}
