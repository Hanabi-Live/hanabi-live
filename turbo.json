{
  "$schema": "https://turborepo.dev/schema.json",
  "cacheDir": ".turbo/cache",
  "globalDependencies": [
    ".gitignore",
    "bunfig.toml",
    "eslint.config.mjs",
    "patches/**",
    "tsconfig*.json"
  ],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "lint": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/lint/check-typescript.sh"
      ],
      "outputs": []
    },
    "//#check-css": {
      "inputs": [
        "bun.lock",
        "package.json",
        "packages/scripts/src/buildCss.ts",
        "public/css/**",
        "!public/css/main.*.min.css",
        "scripts/lint/check-css.sh"
      ],
      "env": [
        "CI",
        "ImageOS",
        "ImageVersion",
        "NODE_ENV",
        "RUNNER_ARCH",
        "RUNNER_OS"
      ],
      "outputs": []
    },
    "//#check-emoji": {
      "dependsOn": ["@hanabi-live/scripts#transit"],
      "cache": false
    },
    "//#check-knip": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "env": [
        "CI",
        "ImageOS",
        "ImageVersion",
        "NODE_ENV",
        "RUNNER_ARCH",
        "RUNNER_OS"
      ],
      "outputs": []
    },
    "//#check-shellcheck": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/.husky/**"],
      "env": [
        "CI",
        "ImageOS",
        "ImageVersion",
        "RUNNER_ARCH",
        "RUNNER_OS",
        "SHELLCHECK_OPTS"
      ],
      "outputs": []
    },
    "//#check-templates": {
      "env": [
        "CI",
        "ImageOS",
        "ImageVersion",
        "NODE_ENV",
        "RUNNER_ARCH",
        "RUNNER_OS"
      ],
      "outputs": []
    },
    "//#check-variant-files": {
      "dependsOn": ["@hanabi-live/scripts#transit"],
      "inputs": ["bun.lock", "misc/variants.txt", "package.json"],
      "env": [
        "CI",
        "ImageOS",
        "ImageVersion",
        "NODE_ENV",
        "RUNNER_ARCH",
        "RUNNER_OS"
      ],
      "outputs": []
    },
    "//#lint-package-json": {
      "dependsOn": ["@hanabi-live/scripts#transit"],
      "inputs": ["bun.lock", "package.json", "packages/*/package.json"],
      "env": [
        "CI",
        "ImageOS",
        "ImageVersion",
        "NODE_ENV",
        "RUNNER_ARCH",
        "RUNNER_OS"
      ],
      "outputs": []
    },
    "//#lint-rust": {
      "inputs": [
        "!**/*.md",
        ".cargo/config.toml",
        ".prettierignore",
        "bun.lock",
        "install/database_schema.sql",
        "install/migration-files.sh",
        "install/migrations/**",
        "package.json",
        "packages/data/src/generated/**",
        "packages/data/src/json/goRandom.json",
        "packages/data/tsconfig*.json",
        "packages/game/src/generated/**",
        "packages/game/src/json/**",
        "packages/game/tsconfig*.json",
        "prettier.config.mjs",
        "rust-toolchain.toml",
        "scripts/dev/generate-protocol.sh",
        "scripts/lint/check-rust.sh",
        "server/**",
        "!server/**/target/**"
      ],
      "env": [
        "CARGO_BUILD_TARGET",
        "CARGO_ENCODED_RUSTFLAGS",
        "CI",
        "HANABI_BUILD_REVISION",
        "ImageOS",
        "ImageVersion",
        "RUNNER_ARCH",
        "RUNNER_OS",
        "RUSTFLAGS",
        "RUSTUP_TOOLCHAIN",
        "SQLX_OFFLINE"
      ],
      "passThroughEnv": [
        "CARGO_HOME",
        "CARGO_INCREMENTAL",
        "CARGO_PROFILE_DEV_DEBUG",
        "RUSTUP_HOME"
      ],
      "outputs": []
    },
    "//#test-client": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!install/**",
        "!packages/scripts/**",
        "!packages/testing/**",
        "!public/**",
        "!server/**"
      ],
      "env": [
        "CI",
        "ImageOS",
        "ImageVersion",
        "NODE_ENV",
        "RUNNER_ARCH",
        "RUNNER_OS",
        "TZ"
      ],
      "outputs": []
    },
    "//#test-rust": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!packages/client/**",
        "!packages/data/**/*.ts",
        "!packages/game/**/*.ts",
        "!packages/scripts/**",
        "!packages/testing/**",
        "!public/**"
      ],
      "env": [
        "CARGO_BUILD_TARGET",
        "CARGO_ENCODED_RUSTFLAGS",
        "CI",
        "HANABI_BUILD_REVISION",
        "HANABI_TEST_DATABASE_URL",
        "ImageOS",
        "ImageVersion",
        "LD_LIBRARY_PATH",
        "NODE_ENV",
        "RUNNER_ARCH",
        "RUNNER_OS",
        "RUSTFLAGS",
        "RUSTUP_TOOLCHAIN",
        "TZ"
      ],
      "passThroughEnv": [
        "CARGO_HOME",
        "CARGO_INCREMENTAL",
        "CARGO_PROFILE_DEV_DEBUG",
        "RUSTUP_HOME"
      ],
      "outputs": []
    },
    "//#test-bun": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!packages/client/**",
        "!public/**"
      ],
      "env": [
        "CARGO_BUILD_TARGET",
        "CARGO_ENCODED_RUSTFLAGS",
        "CI",
        "HANABI_BUILD_REVISION",
        "HANABI_TEST_DATABASE_URL",
        "ImageOS",
        "ImageVersion",
        "LD_LIBRARY_PATH",
        "NODE_ENV",
        "RUNNER_ARCH",
        "RUNNER_OS",
        "RUSTFLAGS",
        "RUSTUP_TOOLCHAIN",
        "TZ"
      ],
      "passThroughEnv": [
        "CARGO_HOME",
        "CARGO_INCREMENTAL",
        "CARGO_PROFILE_DEV_DEBUG",
        "RUSTUP_HOME"
      ],
      "outputs": []
    },
    "//#test-critical-css": {
      "inputs": [
        "bun.lock",
        "package.json",
        "packages/scripts/src/buildCss.ts",
        "packages/testing/package.json",
        "packages/testing/src/criticalCss.ts",
        "packages/testing/src/database.ts",
        "packages/testing/src/mainProcessSupport.ts",
        "packages/testing/src/runTests.ts",
        "public/css/**",
        "!public/css/main.*.min.css",
        "public/webfonts/**",
        "server/templates/**"
      ],
      "env": [
        "CARGO_BUILD_TARGET",
        "CARGO_ENCODED_RUSTFLAGS",
        "CI",
        "HANABI_BUILD_REVISION",
        "HANABI_TEST_DATABASE_URL",
        "ImageOS",
        "ImageVersion",
        "LD_LIBRARY_PATH",
        "NODE_ENV",
        "RUNNER_ARCH",
        "RUNNER_OS",
        "RUSTFLAGS",
        "RUSTUP_TOOLCHAIN",
        "TZ"
      ],
      "passThroughEnv": [
        "CARGO_HOME",
        "CARGO_INCREMENTAL",
        "CARGO_PROFILE_DEV_DEBUG",
        "RUSTUP_HOME"
      ],
      "outputs": []
    }
  }
}
