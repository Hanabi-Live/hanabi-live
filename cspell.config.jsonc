{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "import": ["@cspell/cspell-bundled-dicts"],
  "files": ["**"],
  "enableFiletypes": ["*"],
  "enableGlobDot": true,
  "useGitignore": true,
  "ignorePaths": [
    "*.min.js",
    "*.mp3",
    "*.pyc",
    "*.svg",
    ".git/**",
    ".yarn/**",
    "bun.lock",
    "dist/**",
    "LICENSE",
    "node_modules/**",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    // @template-customization-start
    // Assets which are not edited by hand.
    "*.cdr",
    "*.flp",
    "*.pdn",
    // Autogenerated files
    "hanabi.websynths-patch.json",
    "go.sum",
    "Cargo.lock",
    "server/.sqlx/**",
    // Minified dependencies
    "*.min.js",
    "*.min.css",
    // CSS files might have strange paths.
    "hanabi.css",
    "defaults.css",
    // Emoji names are often two words without a space.
    "emojis.json",
    // Most emote names are not words.
    "emotes.json",
    // Rust build output. ".gitignore" excludes it, but CSpell would still search it, which is slow.
    "server/target/**",
    // @template-customization-end
  ],
  // @template-customization-start
  // Encoded Argon2 password fixtures are not natural-language text.
  "ignoreRegExpList": ["/\\$argon2id\\$[^\"\\r\\n]+/g"],
  // @template-customization-end
  "words": [
    "abacusspiele",
