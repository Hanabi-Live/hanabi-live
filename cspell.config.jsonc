{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "import": ["@cspell/cspell-bundled-dicts"],
  "files": ["**"],
  "enableFiletypes": ["*"],
  "enableGlobDot": true,
  "useGitignore": true,
  "ignorePaths": [
    "*.min.js",
    "*.mp3",
    "*.pyc",
    "*.svg",
    ".git/**",
    ".yarn/**",
    "bun.lock",
    "dist/**",
    "LICENSE",
    "node_modules/**",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    // @template-customization-start
    ".direnv/**",
    "flake.lock",
    "flake.nix",
    // Assets which are not edited by hand.
    "*.cdr",
    "*.flp",
    "*.pdn",
    // Autogenerated files
    "hanabi.websynths-patch.json",
    "go.sum",
    "Cargo.lock",
    "experimental/rust-server/.sqlx/**",
    "packages/data/src/json/goIdentity.json",
    "packages/data/src/json/goUnidecode.LICENSE",
    "server/src/testdata/chat_protocol.json",
    "server/src/testdata/character_setup.json",
    "server/src/testdata/deck_setup.json",
    "server/src/testdata/engine_authority.json",
    "server/src/testdata/go_rust_cutover.json",
    "server/src/testdata/random_protocol.json",
    "server/src/testdata/session_protocol.json",
    "server/src/testdata/username_protocol.json",
    // Minified dependencies
    "*.min.js",
    "*.min.css",
    // CSS files might have strange paths.
    "hanabi.css",
    // Archived files where spelling errors will not be fixed.
    "/misc/keldon/**",
    "/misc/server-old/src/views/index.ejs",
    // Third-party assets.
    "/misc/card-images/src/lib/canvas2svg_node.js",
    "/public/css/lib/alpha.css",
    // Emoji names are often two words without a space.
    "emojis.json",
    // Most emote names are not words.
    "emotes.json",
    // Word lists
    "word_list.txt",
    "words.txt",
    // @template-customization-end
  ],
  // @template-customization-start
  // Encoded Argon2 password fixtures are not natural-language text.
  "ignoreRegExpList": ["/\\$argon2id\\$[^\"\\r\\n]+/g"],
