[Unit]
Description=Durable Redis for the Hanab Live Rust server
After=network.target

[Service]
Type=simple
User=hanabi-redis
Group=hanabi-redis
ExecStart=/usr/bin/redis-server /etc/hanabi-redis/redis.conf
Restart=on-failure
RestartSec=2
TimeoutStopSec=120
RuntimeDirectory=hanabi-redis
RuntimeDirectoryMode=0700
StateDirectory=hanabi-redis
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
