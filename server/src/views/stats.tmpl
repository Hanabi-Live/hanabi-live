{{ define "content" }}
  <div id="page-wrapper">
    <!-- Header -->
    <header id="header">
      <h1>{{ template "logo" }}</h1>
      <nav id="nav"></nav>
    </header>

    <!-- Main -->
    <section id="main" class="container max history-page">
      <header>
        <h2><img src="/public/img/logos/header.svg" width="259" /></h2>
      </header>
      <div class="row uniform 100%">
        <div class="col-12">
          <section class="box">
            <h2 class="align-center">Global Statistics</h2>
            <div class="history-bullets">
              <ul>
                <li>
                  <span class="stat-description"
                    >Games played (in non-speedruns):</span
                  >
                  {{ .NumGamesTotal }} ({{ .NumGamesNormal }} normally
                  terminated)
                </li>
                <li>
                  <span class="stat-description"
                    >Time spent playing (in non-speedruns):</span
                  >
                  {{ if .TimePlayed }}
                    {{ .TimePlayed }}
                  {{ else }}
                    -
                  {{ end }}
                </li>
                <li>
                  <span class="stat-description"
                    >Games played (in speedruns):</span
                  >
                  {{ .NumGamesSpeedrun }}
                </li>
                <li>
                  <span class="stat-description"
                    >Time spent playing (in speedruns):</span
                  >
                  {{ if .TimePlayedSpeedrun }}
                    {{ .TimePlayedSpeedrun }}
                  {{ else }}
                    -
                  {{ end }}
                </li>
              </ul>
            </div>
          </section>
        </div>
      </div>
    </section>
  </div>
{{ end }}
