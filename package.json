{
  "name": "hanabi-live-monorepo",
  "private": true,
  "description": "A web server that allows people to play Hanab, a cooperative card game of logic and reasoning.",
  "homepage": "https://github.com/Hanabi-Live/hanabi-live#readme",
  "bugs": {
    "url": "https://github.com/Hanabi-Live/hanabi-live/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hanabi-Live/hanabi-live.git"
  },
  "license": "GPL-3.0",
  "author": "Zamiell",
  "type": "commonjs",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@reduxjs/toolkit": "2.14.0",
      "@sinonjs/fake-timers": "15.0.0",
      "@tailwindcss/vite": "4.3.5",
      "@testing-library/dom": "10.4.2",
      "@testing-library/react": "16.3.3",
      "@types/bun": "1.4.4",
      "@types/jquery": "4.0.1",
      "@types/jsdom": "30.0.0",
      "@types/linkifyjs": "2.1.7",
      "@types/lodash": "4.17.26",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@types/sinonjs__fake-timers": "15.0.1",
      "@types/ws": "8.18.2",
      "@vitejs/plugin-react": "6.2.1",
      "complete-cli": "1.5.35",
      "complete-common": "2.32.0",
      "complete-lint": "5.28.0",
      "complete-node": "18.1.2",
      "esbuild": "0.28.2",
      "fast-deep-equal": "3.1.3",
      "git-pull-run": "2.1.0",
      "husky": "9.1.7",
      "immer": "11.1.21",
      "interactjs": "1.10.28",
      "jquery": "4.0.0",
      "jsdom": "30.1.3",
      "keycode-js": "3.1.0",
      "konva": "3.4.1",
      "lightningcss": "1.33.0",
      "linkify-html": "4.3.3",
      "linkifyjs": "4.3.3",
      "lodash": "4.18.1",
      "playwright": "1.65.0",
      "postgres": "3.4.9",
      "prettier": "3.9.10",
      "prettier-plugin-sh": "0.20.2",
      "prettier-plugin-toml": "4.1.0",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "react-redux": "9.3.1",
      "redux": "5.0.1",
      "tailwindcss": "4.3.5",
      "tslib": "2.8.1",
      "turbo": "2.11.10",
      "typedoc": "0.28.20",
      "typescript": "6.0.3",
      "vite": "8.3.5",
      "vitest": "5.1.0",
      "ws": "8.20.0",
      "zod": "4.6.5"
    }
  },
  "scripts": {
    "build-client": "bash packages/client/build-client.sh",
    "build-critical-css": "bun packages/testing/src/runTests.ts critical-css --write",
    "build-standalone": "bash scripts/dev/build-standalone.sh",
    "check-css": "bash scripts/lint/check-css.sh",
    "check-deployment": "bun --tsconfig-override tsconfig.monorepo.json ./packages/scripts/src/checkDeployment.mts",
    "check-emoji": "bun --tsconfig-override tsconfig.monorepo.json ./packages/scripts/src/checkEmoji.mts",
    "check-knip": "bunx --bun --no-install knip --treat-config-hints-as-errors",
    "check-shellcheck": "bash scripts/lint/check-shellcheck.sh",
    "check-templates": "bash scripts/lint/check-templates.sh",
    "check-variant-files": "bun --tsconfig-override tsconfig.monorepo.json ./packages/scripts/src/createVariantsJSON/checkVariantFiles.ts",
    "create-variants-json": "bun --tsconfig-override tsconfig.monorepo.json ./packages/scripts/src/createVariantsJSON/createVariantsJSONScript.ts",
    "dev": "bun --tsconfig-override tsconfig.monorepo.json ./packages/scripts/src/dev.mts",
    "lint": "bash ./lint.sh",
    "lint-package-json": "bun --tsconfig-override tsconfig.monorepo.json ./packages/scripts/src/lintPackageJSON.mts",
    "lint-rust": "bash scripts/lint/check-rust.sh",
    "prepare": "husky",
    "test": "bunx --bun --no-install turbo run test-client test-rust test-bun test-critical-css --cache=local:rw --output-logs=new-only --concurrency=1",
    "test-bun": "bun packages/testing/src/runTests.ts bun",
    "test-client": "bun run --cwd packages/client test",
    "test-critical-css": "bun packages/testing/src/runTests.ts critical-css",
    "test-rust": "bun packages/testing/src/runTests.ts rust",
    "update": "bun --tsconfig-override tsconfig.monorepo.json ./packages/scripts/src/update.mts"
  },
  "dependencies": {
    "@types/bun": "catalog:",
    "prettier": "catalog:",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "complete-cli": "catalog:",
    "complete-lint": "catalog:",
    "git-pull-run": "catalog:",
    "husky": "catalog:",
    "prettier-plugin-sh": "catalog:",
    "prettier-plugin-toml": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "konva@3.4.1": "patches/konva@3.4.1.patch"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "esbuild",
    "unrs-resolver"
  ]
}
