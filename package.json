    "fastify-favicon": "5.0.0",
    "fastq": "1.20.3",
    "grunt": "1.6.3",
    "grunt-contrib-concat": "2.1.0",
    "grunt-contrib-cssmin": "5.0.0",
    "grunt-criticalcss": "2.1.0",
